# Verilənlər bazası faylı (SQLite)
DB_PATH=data/transit.db

# Analitika
LOAD_WINDOW_MINUTES=10      # yük səviyyəsi hesablanan pəncərə
ANOMALY_MINUTES=10          # "Yüksək" fasiləsiz davam etməli olduğu müddət
ANOMALY_MIN_REPORTS=3       # pəncərədə minimum hesabat sayı
ANALYTICS_EVAL_SECONDS=15   # mühərrikin qiymətləndirmə intervalı

# GPS simulyatoru
SIM_ENABLED=1               # 0 = avtobuslar hərəkət etmir, fon tapşırıqları işləmir
SIM_REPORTS=1               # 0 = virtual sərnişin hesabatları yaradılmır
SIM_TICK_SECONDS=2
SEED_ROUTE_LIMIT=            # boş = AYNA-dan bütün 198 marşrut; məs. 12 = yalnız izlənən xətlər (yüngül rejim)
DWELL_SECONDS=20
